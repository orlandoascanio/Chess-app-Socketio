# Express + Socket.IO listen port (required).
# Must match VITE_SERVER_URL in chess-app/client/.env (host + port).
PORT=3000

# Set to 1 to use in-memory room storage (no PostgreSQL).
# Rooms are lost on server restart — fine for quick local tests and verify-socket-flow.mjs.
USE_MEMORY_STORE=1

# PostgreSQL connection URL (required when USE_MEMORY_STORE is not 1).
# POSTGRES_URL is accepted as an alias.
#
# Local example:
#   createdb chess_app
#   USE_MEMORY_STORE=0
#   DATABASE_URL=postgresql://localhost:5432/chess_app
#
# Use a direct connection URL for remote Postgres (not pooled Prisma URLs — they often ECONNRESET locally).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# OpenRouter API key — enables LLM move commentary via OpenRouter.
# Leave empty to use built-in rule-based commentary (no external API calls).
OPENROUTER_API_KEY=

# OpenRouter model id (default: deepseek/deepseek-v4-flash).
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional: attribution headers sent to OpenRouter (shown on your OpenRouter dashboard).
# OPENROUTER_HTTP_REFERER=http://localhost:5173
# OPENROUTER_APP_TITLE=Chess App

# Optional: comma-separated browser origins allowed by Express CORS (production).
# CORS_ORIGINS=http://localhost:5173
